# ==========================================================
# CONCRETANDO (Next.js + Node.js + Supabase + Vercel)
# ==========================================================
# Copie para .env.local em desenvolvimento ou configure nas
# Environment Variables do projeto na Vercel.

# --- ACESSO EXCLUSIVO DO ADMINISTRADOR (/admin) ---
ADMIN_EMAIL=admin@concretando.com.br
ADMIN_PASSWORD=Concretando@2026
ADMIN_SESSION_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# --- SUPABASE (Banco de Dados PostgreSQL em Nuvem) ---
# Se não preenchido, o sistema usa automaticamente o Banco de Dados Local (.data/concretando-db.json)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-publica-anon
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# --- INTEGRAÇÕES EXTERNAS (OPCIONAL) ---
CONCRETANDO_API_KEY=sua-api-key-para-erp
WEBHOOK_ORDERS_URL=
