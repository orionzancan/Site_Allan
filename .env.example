# ==========================================================
# CONCRETANDO - Variáveis de Ambiente (Vercel + Supabase)
# ==========================================================
# Copie este arquivo para .env.local (local) ou configure no
# painel da Vercel em: Project Settings -> Environment Variables

# --- SUPABASE (Banco de Dados PostgreSQL em Nuvem) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# --- SEGURANÇA DE API (Opcional para integrações ERP/Webhook) ---
CONCRETANDO_API_KEY=troque-por-uma-chave-secreta-forte

# --- INTEGRAÇÕES EXTERNAS OPCIONAIS ---
WHATSAPP_BUSINESS_NUMBER=5511999999999
WEBHOOK_ORDERS_URL=
